rules_version = '2';

// AIM TEAM LMS — Firestore 보안 규칙 (Firebase Auth 기반)
//
// 핵심 아이디어
//  - 관리자 = `admins/{uid}` 문서가 존재하는 사용자. 이 컬렉션은 앱에서 쓸 수 없고
//    Firebase 콘솔에서만 만들 수 있으므로, 개발자도구로 권한을 얻을 수 없다.
//  - 학생 본인 = `students/{학번}.uid == request.auth.uid`.
//    성적/진도/응시기록은 본인 것만 쓸 수 있다.
//  - 성적과 부정행위 로그는 아무도 삭제할 수 없다(관리자 포함, 콘솔 제외).
//
// 배포:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------- 헬퍼 ---------------------------- */
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 해당 학번의 주인인가
    function ownsStudent(sid) {
      return signedIn()
             && exists(/databases/$(database)/documents/students/$(sid))
             && get(/databases/$(database)/documents/students/$(sid)).data.uid == request.auth.uid;
    }

    /* --------------------------- 관리자 --------------------------- */
    // 읽기만 허용(본인 권한 확인용). 부여/회수는 Firebase 콘솔에서만.
    match /admins/{uid} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    /* --------------------------- 팀원 명부 -------------------------- */
    match /students/{studentId} {
      // 로그인 화면에서 학번 존재 여부를 확인해야 하므로 읽기는 공개
      allow read: if true;

      // 명부에 새로 추가하는 건 관리자만 (콘솔에서 만드는 건 규칙과 무관하게 항상 가능)
      allow create: if isAdmin();

      allow update: if
        isAdmin()
        // 최초 가입 시 본인 uid 를 자기 문서에 기록하는 것만 허용.
        // 이미 uid 가 있으면 덮어쓸 수 없어 계정 탈취를 막는다.
        || (signedIn()
            && request.resource.data.uid == request.auth.uid
            && (!('uid' in resource.data) || resource.data.uid == request.auth.uid)
            // 이름/학번을 마음대로 바꾸지 못하게
            && request.resource.data.id == resource.data.id
            && request.resource.data.name == resource.data.name);

      allow delete: if isAdmin();
    }

    /* --------------------------- 학습 콘텐츠 ------------------------- */
    // 학생은 읽기만, 편집은 관리자만
    match /quizzes/{quizId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ----------------------------- 성적 ----------------------------- */
    match /progress/{docId} {
      allow read: if isAdmin() || ownsStudent(resource.data.studentId);
      allow create, update: if isAdmin()
                            || (ownsStudent(request.resource.data.studentId) && validProgress());
      allow delete: if false; // 성적은 누구도 지울 수 없다
    }

    function validProgress() {
      let d = request.resource.data;
      return d.keys().hasAll(['studentId', 'quizId', 'score', 'total'])
             && d.score is int && d.total is int
             && d.score >= 0 && d.total >= 0 && d.score <= d.total;
    }

    /* --------------------------- 레슨 진도 --------------------------- */
    match /lessonProgress/{docId} {
      allow read: if isAdmin() || ownsStudent(resource.data.studentId);
      allow create, update: if isAdmin()
                            || (ownsStudent(request.resource.data.studentId)
                                && request.resource.data.status in ['in_progress', 'completed']);
      allow delete: if false;
    }

    /* -------------------------- 부정행위 로그 ------------------------- */
    match /proctorSessions/{sessionId} {
      // 학생은 자기 기록만, 관리자는 전체 열람
      allow read: if isAdmin() || ownsStudent(resource.data.studentId);
      allow create: if ownsStudent(request.resource.data.studentId);
      // 이벤트 추가/제출 결과 기록만 허용. 학번은 바꿀 수 없다.
      allow update: if ownsStudent(resource.data.studentId)
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.events.size() <= 500;
      allow delete: if false; // 증거 보전
    }

    /* --------------------------- 다른 앱 ---------------------------- */
    // 같은 Firebase 프로젝트를 쓰는 별도 앱(티켓)의 기존 규칙 — 그대로 유지.
    // 이 블록을 지우면 그 앱이 동작하지 않는다.
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null
                        || (resource != null && resource.data.userId == 'global-user-id')
                        || (request.resource != null && request.resource.data.userId == 'global-user-id');
    }

    /* --------------------------- 나머지 차단 -------------------------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
