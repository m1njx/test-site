# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# Render 로 배포한다면 대시보드의 Environment 탭에도 동일하게 넣어야 합니다.

# ── Firebase (없으면 브라우저 localStorage 를 쓰는 Mock 모드로 동작) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── AI 채점 (Gemini) ──
# 주의: 브라우저에서 직접 호출하므로 이 키는 번들에 노출됩니다. 할당량 제한을 걸어두세요.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash

# ── 관리자 게이트 ──
# 평문이 아닌 SHA-256 해시를 넣습니다.  만드는 법:
#   printf '원하는비밀번호' | shasum -a 256
VITE_ADMIN_PASSWORD_HASH=

# ── 자체 비디오 서버 (mp4 직접 호스팅할 때만) ──
# 비워두면 mp4 업로드 UI 가 숨겨지고 YouTube 링크 / 외부 URL 만 사용합니다.
VITE_VIDEO_SERVER_URL=
# 비디오 서버의 UPLOAD_TOKEN 과 같은 값. 관리자 비밀번호와 반드시 다르게!
VITE_VIDEO_UPLOAD_TOKEN=
